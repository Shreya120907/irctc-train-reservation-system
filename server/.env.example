# =============================================================================
# IRCTC-Style Train Reservation Simulator Configuration
# =============================================================================

# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=train_reservation
DB_USER=postgres
DB_PASSWORD=1234
DB_MIN_CONN=2
DB_MAX_CONN=20

# Core TCP Reservation Server
TCP_HOST=0.0.0.0
TCP_PORT=5000
TCP_TIMEOUT=60.0

# Asynchronous UDP Broadcast Service
UDP_HOST=0.0.0.0
UDP_PORT=6000
UDP_BROADCAST_PORT=9999

# REST HTTP Status & Telemetry Service
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# FTP File Transfer Service
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=irctc_ftp
FTP_PASSWORD=ftp_secret_pass
FTP_DIR=files

# SMTP Email Notification Service
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@railnet.gov.in
SMTP_USE_TLS=False

# System Logging
LOG_LEVEL=INFO
LOG_FILE=logs/server.log
